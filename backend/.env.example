# ----------------------------------------------------------------------------
# SPAS BACKEND CONFIGURATION (.env)
# ----------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Supabase)
# Transaction Pooler URL (For app runtime queries)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.gwsgqiuzstolxeiawoqi:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.gwsgqiuzstolxeiawoqi:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# JWT Authentication Secrets
JWT_ACCESS_SECRET="spas_super_secret_access_jwt_key_2026"
JWT_REFRESH_SECRET="spas_super_secret_refresh_jwt_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:5173"

# Internal Python AI Microservice URL
AI_SERVICE_URL="http://127.0.0.1:8503"
AI_SERVICE_TOKEN=""
